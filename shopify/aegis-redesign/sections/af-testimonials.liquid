{%- comment -%}
  Aegis refresh: testimonial cards (stars, quote, name, product).
{%- endcomment -%}
{{ 'af-refresh.css' | asset_url | stylesheet_tag }}

<section
  class="af-testimonials af-scheme--{{ section.settings.scheme }}"
  style="--af-pt: {{ section.settings.padding_top }}px; --af-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="af-container">
    <div class="af-section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="af-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="af-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <ul class="af-testimonials__grid af-testimonials__grid--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="af-quote-card" {{ block.shopify_attributes }}>
          <div class="af-stars" aria-label="5 out of 5 stars">★★★★★</div>
          {%- if block.settings.headline != blank -%}<p class="af-quote-card__headline">{{ block.settings.headline }}</p>{%- endif -%}
          <div class="af-quote-card__text">{{ block.settings.text }}</div>
          <p class="af-quote-card__author">
            {{ block.settings.author }}
            {%- if block.settings.product != blank -%}<span>{{ block.settings.product }}</span>{%- endif -%}
          </p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "AF · Testimonials",
  "tag": "div",
  "class": "af-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people are saying" },
    {
      "type": "select", "id": "scheme", "label": "Color style", "default": "cream",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "headline", "label": "Headline" },
        { "type": "richtext", "id": "text", "label": "Quote", "default": "<p>Customer quote goes here.</p>" },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer" },
        { "type": "text", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [{ "name": "AF · Testimonials" }]
}
{% endschema %}

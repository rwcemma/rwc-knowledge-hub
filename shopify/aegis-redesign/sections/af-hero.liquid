{%- comment -%}
  Aegis refresh: split hero. Headline + supporting copy + two CTAs on one side,
  product/lifestyle image on the other. Falls back to a centered layout with no image.
{%- endcomment -%}
{{ 'af-refresh.css' | asset_url | stylesheet_tag }}

<section
  class="af-hero af-scheme--{{ section.settings.scheme }}{% if section.settings.image == blank %} af-hero--centered{% endif %}"
  style="--af-pt: {{ section.settings.padding_top }}px; --af-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="af-container af-hero__inner">
    <div class="af-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="af-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="af-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="af-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="af-btn-row">
        {%- if section.settings.button_label != blank -%}
          <a class="af-btn af-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="af-btn af-btn--ghost" href="{{ section.settings.button_link_2 | default: '#' }}">
            {{- section.settings.button_label_2 -}}
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="af-hero__points" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="af-check" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="14" height="14"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="af-hero__media">
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '400, 600, 800, 1000, 1200, 1600',
            class: 'af-hero__img'
        }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AF · Hero",
  "tag": "div",
  "class": "af-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Doctor-formulated · Nanoliposomal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Well-being, elevated." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Supplements built for real absorption, so you feel the difference.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop all products" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Our science" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    {
      "type": "select", "id": "scheme", "label": "Color style", "default": "cream",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Check point",
      "limit": 4,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Third-party tested" }]
    }
  ],
  "presets": [{ "name": "AF · Hero" }]
}
{% endschema %}

{%- comment -%}
  Aegis refresh: curated product grid from a collection. Clean cards with a tinted
  image well, product name, short tagline (product.metafields.custom.tagline if set,
  else product type), price, and a "Shop now" button.
{%- endcomment -%}
{{ 'af-refresh.css' | asset_url | stylesheet_tag }}

{%- assign collection = section.settings.collection -%}
<section
  class="af-products af-scheme--{{ section.settings.scheme }}"
  style="--af-pt: {{ section.settings.padding_top }}px; --af-pb: {{ section.settings.padding_bottom }}px; --af-cols: {{ section.settings.columns }};"
>
  <div class="af-container">
    <div class="af-section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="af-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="af-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="af-lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <ul class="af-products__grid" role="list">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li class="af-card">
            <a class="af-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '300, 400, 600, 800',
                    alt: product.featured_media.alt | default: product.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'af-placeholder' }}
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="af-badge">Save {{ product.compare_at_price | minus: product.price | money_without_trailing_zeros }}</span>
              {%- elsif product.available == false -%}
                <span class="af-badge af-badge--muted">Sold out</span>
              {%- endif -%}
            </a>
            <div class="af-card__body">
              <h3 class="af-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              {%- assign tagline = product.metafields.custom.tagline.value | default: product.type | split: '>' | last | strip -%}
              {%- if tagline != blank -%}<p class="af-card__tag">{{ tagline }}</p>{%- endif -%}
              <div class="af-card__foot">
                <span class="af-card__price">
                  {%- if product.price_varies -%}From {% endif -%}
                  {{ product.price | money }}
                </span>
                <a class="af-btn af-btn--sm af-btn--primary" href="{{ product.url }}">Shop now</a>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="af-card">
            <div class="af-card__media">{{ 'product-1' | placeholder_svg_tag: 'af-placeholder' }}</div>
            <div class="af-card__body"><h3 class="af-card__title">Product name</h3></div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="af-center">
        <a class="af-btn af-btn--ghost" href="{{ section.settings.button_link | default: collection.url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AF · Product grid",
  "tag": "div",
  "class": "af-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our most popular formulas" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "scheme", "label": "Color style", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "AF · Product grid" }]
}
{% endschema %}

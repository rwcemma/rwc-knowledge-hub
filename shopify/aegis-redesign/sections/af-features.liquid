{%- comment -%}
  Aegis refresh: education / science block. Section heading + up to 4 feature
  cards (image or number, title, text) + optional CTA.
{%- endcomment -%}
{{ 'af-refresh.css' | asset_url | stylesheet_tag }}

<section
  class="af-features af-scheme--{{ section.settings.scheme }}"
  style="--af-pt: {{ section.settings.padding_top }}px; --af-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="af-container">
    <div class="af-section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="af-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="af-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="af-lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <ul class="af-features__grid af-features__grid--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="af-feature" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="af-feature__icon">
              {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.title }}
            </div>
          {%- else -%}
            <div class="af-feature__num">{{ forloop.index | prepend: '0' }}</div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="af-feature__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="af-feature__text">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="af-center">
        <a class="af-btn {% if section.settings.scheme == 'navy' %}af-btn--gold{% else %}af-btn--primary{% endif %}" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AF · Features",
  "tag": "div",
  "class": "af-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why it works" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "scheme", "label": "Color style", "default": "navy",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon / image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "AF · Features" }]
}
{% endschema %}

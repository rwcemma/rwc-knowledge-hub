{%- comment -%}
  Aegis refresh: closing call-to-action band.
{%- endcomment -%}
{{ 'af-refresh.css' | asset_url | stylesheet_tag }}

<section
  class="af-cta af-scheme--{{ section.settings.scheme }}"
  style="--af-pt: {{ section.settings.padding_top }}px; --af-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="af-container">
    <div class="af-cta__box">
      {%- if section.settings.heading != blank -%}<h2 class="af-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="af-lead">{{ section.settings.text }}</div>{%- endif -%}
      <div class="af-btn-row af-btn-row--center">
        {%- if section.settings.button_label != blank -%}
          <a class="af-btn af-btn--gold" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="af-btn af-btn--ghost-light" href="{{ section.settings.button_link_2 | default: '#' }}">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AF · CTA band",
  "tag": "div",
  "class": "af-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to feel the difference?" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    {
      "type": "select", "id": "scheme", "label": "Page background around the band", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "AF · CTA band" }]
}
{% endschema %}

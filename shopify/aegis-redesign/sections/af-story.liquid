{%- comment -%}
  Aegis refresh: image + story copy (founder / mission), with optional pull quote.
{%- endcomment -%}
{{ 'af-refresh.css' | asset_url | stylesheet_tag }}

<section
  class="af-story af-scheme--{{ section.settings.scheme }}{% if section.settings.image_right %} af-story--reverse{% endif %}{% if section.settings.image_fit == 'contain' %} af-story--contain{% endif %}"
  style="--af-pt: {{ section.settings.padding_top }}px; --af-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="af-container af-story__inner">
    <div class="af-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1400'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'af-placeholder' }}
      {%- endif -%}
    </div>
    <div class="af-story__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="af-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="af-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="af-body">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.quote != blank -%}
        <blockquote class="af-story__quote">
          <p>{{ section.settings.quote }}</p>
          {%- if section.settings.quote_author != blank -%}<cite>{{ section.settings.quote_author }}</cite>{%- endif -%}
        </blockquote>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="af-btn-row">
          {%- if section.settings.button_label != blank -%}
            <a class="af-btn af-btn--primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="af-btn af-btn--ghost" href="{{ section.settings.button_link_2 | default: '#' }}">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AF · Story",
  "tag": "div",
  "class": "af-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_right", "label": "Image on right", "default": false },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill (photos)" },
        { "value": "contain", "label": "Fit (illustrations)" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "quote", "label": "Pull quote" },
    { "type": "text", "id": "quote_author", "label": "Quote author" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    {
      "type": "select", "id": "scheme", "label": "Color style", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "AF · Story" }]
}
{% endschema %}

{%- comment -%}
  Aegis refresh: row of trust badges (icon + short label + optional sub-label).
{%- endcomment -%}
{{ 'af-refresh.css' | asset_url | stylesheet_tag }}

<section class="af-trust af-scheme--{{ section.settings.scheme }}">
  <div class="af-container">
    <ul class="af-trust__list" role="list">
      {%- for block in section.blocks -%}
        <li class="af-trust__item" {{ block.shopify_attributes }}>
          <span class="af-trust__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'doctor' -%}
                <svg viewBox="0 0 24 24"><path d="M6 3v5a4 4 0 008 0V3M10 12v3a5 5 0 0010 0v-2" /><circle cx="20" cy="11" r="2" /></svg>
              {%- when 'lab' -%}
                <svg viewBox="0 0 24 24"><path d="M9 3h6M10 3v6l-5 9a2 2 0 001.7 3h10.6a2 2 0 001.7-3l-5-9V3" /><path d="M7.5 15h9" /></svg>
              {%- when 'absorb' -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3.5" /><path d="M12 1v3M12 20v3M1 12h3M20 12h3" /></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-14 15-15-1 10-7 15-15 15z" /><path d="M5 19l8-8" /></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /><path d="M8.5 12l2.5 2.5 4.5-5" /></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24"><path d="M2 6h12v10H2zM14 10h4l4 3v3h-8" /><circle cx="6" cy="18" r="2" /><circle cx="18" cy="18" r="2" /></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><path d="M12 2l3 6.5 7 .8-5.2 4.8 1.4 7-6.2-3.6L5.8 21l1.4-7L2 9.3l7-.8z" /></svg>
            {%- endcase -%}
          </span>
          <span class="af-trust__text">
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "AF · Trust bar",
  "tag": "div",
  "class": "af-section",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color style", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 6,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "star",
          "options": [
            { "value": "doctor", "label": "Doctor" },
            { "value": "lab", "label": "Lab tested" },
            { "value": "absorb", "label": "Absorption" },
            { "value": "leaf", "label": "Clean ingredients" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Shipping" },
            { "value": "star", "label": "Star" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Badge title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [{ "name": "AF · Trust bar" }]
}
{% endschema %}
